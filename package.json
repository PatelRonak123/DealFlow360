{
  "name": "dealflow360",
  "version": "1.0.0",
  "private": true,
  "description": "DealFlow360 - Enterprise CPQ, Deal Governance, and Revenue Operations Platform",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm --prefix client run build && npm --prefix server run build",
    "lint": "npm --prefix client run lint && npm --prefix server run lint",
    "typecheck": "npm --prefix client run typecheck && npm --prefix server run typecheck",
    "test": "npm --prefix server run test"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.5",
    "concurrently": "^9.1.2",
    "magic-string": "^1.2.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tapable": "^2.3.3"
  },
  "keywords": [
    "cpq",
    "enterprise",
    "dealflow",
    "monorepo"
  ],
  "author": "DealFlow360 Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.41.0",
    "react-hook-form": "^7.87.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  }
}
